{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Lets the packaged workspace reach the desktop commands.",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "allow-app-version",
    "allow-check-for-updates",
    "allow-open-external-url",
    "allow-pick-folder",
    "allow-workspace-command"
  ]
}
