{
  "name": "tasknboard",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "tasknboard": "dist-cli/tasknboard.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node server/http.mjs",
    "mcp": "node server/mcp.mjs",
    "cli": "node --disable-warning=ExperimentalWarning dist-cli/tasknboard.mjs",
    "build": "tsc --noEmit && tsc --noEmit -p cli && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "test": "npm run build:cli && node --test tests/*.test.mjs",
    "test:ui": "node tests/browser/run.mjs",
    "seed": "node server/seed.mjs",
    "desktop:prepare": "npm run build && node scripts/desktop-prepare.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "desktop:build:windows": "tauri build --bundles nsis",
    "tauri": "tauri"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tauri-apps/api": "^2.12.0",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
